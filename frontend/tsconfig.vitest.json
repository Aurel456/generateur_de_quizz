{
    "extends": "./tsconfig.app.json",
    "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
    "exclude": [],
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
        // `lib` n'est PAS remis à [] : on hérite de DOM/DOM.Iterable de
        // tsconfig.app.json, sans quoi `document`, `KeyboardEvent`,
        // `HTMLInputElement`… disparaissent et `npm run type-check` échoue.
        "types": ["node"]
    }
}
