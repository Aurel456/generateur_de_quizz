OPENAI_API_BASE=http://votre-serveur:8080/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Modèle texte
TEXT_MODEL_NAME=gtp-oss-120b
TEXT_MODEL_CONTEXT=32000

# Encodeur tiktoken (cl100k_base pour GPT-4, o200k_base pour GPT-4o)
TIKTOKEN_ENCODING=cl100k_base

# Modèle Vision (optionnel)
VISION_MODEL_NAME=Qwen3-VL-32B-Instruct-FP8
VISION_MODEL_CONTEXT=262000

# Base de données SQLite pour les sessions partagées
QUIZ_SESSIONS_DB=shared_data/quiz_sessions.db
GLOBAL_STATS=shared_data/global_stats.json

# Référentiel d'acronymes (détecté automatiquement à l'upload)
ACRONYMS_REFERENCE=reference_data/acronyms.json

# Backend DSFR — mode One-shot vision : budget de contexte du modèle. Au-delà, les
# documents sont découpés (1 bloc par document, puis en tranches de ONESHOT_SLICE_TOKENS).
ONESHOT_MAX_TOTAL_TOKENS=190000
ONESHOT_SLICE_TOKENS=50000
